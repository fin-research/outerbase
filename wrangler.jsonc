{
  "main": ".open-next/worker.js",
  "name": "outerbase",
  "minify": true,
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "8247fa4562c1427eb4541e786d9d11bc"
    }
  ]
}
